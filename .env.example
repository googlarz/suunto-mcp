# Suunto OAuth app credentials — get these from https://apizone.suunto.com
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
SUUNTO_SUBSCRIPTION_KEY=

# Where the OAuth callback lands during pairing.
# Must match the redirect URI you registered in the Suunto developer portal.
SUUNTO_REDIRECT_URI=http://localhost:8421/callback

# Where to store the token bundle (defaults to ~/.suunto-mcp/tokens.json).
# Plain JSON with file permissions restricted to your user (chmod 600) — not
# encrypted at rest. For real encryption, set SUUNTO_TOKEN_STORAGE=keychain
# instead (stores tokens in the OS keychain; see the Advanced section).
SUUNTO_TOKEN_PATH=

# Optional: override the path prefix for the 24/7 / sleep / recovery products
# if your apizone entitlement uses a different one. Default is /247samples.
SUUNTO_DAILY_PREFIX=

# Required only for push_workout_guide. Must exactly match the app name you
# registered on apizone.suunto.com — the Guide Cloud API rejects uploads
# where manifest.json's "owner" field doesn't match.
SUUNTO_APP_NAME=
